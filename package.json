{
  "name": "formwise",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @formwise/api\" \"npm run dev -w @formwise/builder\"",
    "build": "npm run build -w @formwise/renderer && npm run build -w @formwise/builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/renderer/tsconfig.json && tsc -b apps/builder && tsc -p apps/api/tsconfig.json",
    "lint": "oxlint",
    "e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w @formwise/api"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.6.7"
  }
}
